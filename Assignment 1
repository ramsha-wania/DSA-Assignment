Ques 1. Stack Implementation Using Array:
A Stack is a linear data structure that follows LIFO (Last In, First Out).
PUSH(10)
PUSH(20)
PUSH(30)
Stack:
   30  ← TOP
   20
   10

Operations:
PUSH(x) → Inserts an element into the stack.
POP() → Removes the top element from the stack.
PEEK() → Returns the top element without removing it.
DISPLAY() → Displays all the elements of the stack.

#include <stdio.h>
#define MAX 5
int stack[MAX];
int top = -1;

// PUSH operation
void PUSH(int x)
{
    if (top == MAX - 1)
    {
        printf("Stack Overflow! Stack is full.\n");
        return;
    }
    top++;
    stack[top] = x;
    printf("%d pushed into stack.\n", x);
}

// POP operation
void POP()
{
    if (top == -1)
    {
        printf("Stack Underflow! Stack is empty.\n");
        return;
    }
    printf("%d popped from stack.\n", stack[top]);
    top--;
}

// PEEK operation
void PEEK()
{
    if (top == -1)
    {
        printf("Stack is empty.\n");
        return;
    }
    printf("Top element = %d\n", stack[top]);
}

// DISPLAY operation
void DISPLAY()
{
    if (top == -1)
    {
        printf("Stack is empty.\n");
        return;
    }
    printf("Stack elements are:\n");

    for (int i = top; i >= 0; i--)
    {
        printf("%d\n", stack[i]);
    }
}

// Main function
int main()
{
    PUSH(10);
    PUSH(20);
    PUSH(30);

    DISPLAY();

    PEEK();

    POP();

    DISPLAY();

    return 0;
}

